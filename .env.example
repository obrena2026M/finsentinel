# Copy to .env (local dev/demo) — never commit .env
PORT=3000
# Bind address: 127.0.0.1 for local use; 0.0.0.0 behind a reverse proxy or in a container
HOST=127.0.0.1
DB_PATH=./data/finsentinel.db
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_MODE=simulation
LLM_GATEWAY=mock
# LLM_GATEWAY=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
LOG_LEVEL=info
# Needed on this machine so Node trusts the corporate proxy CA (tools.md §2.1)
NODE_USE_SYSTEM_CA=1
SEED_ON_START=1
# --- Production hardening (STAGE05 DEP-05/DEP-07); see documents/STAGE05_Deployment.md ---
# NODE_ENV=production          # refuses SEED_ON_START=1 unless ALLOW_SEED=1; disables pretty logs
# TRUST_PROXY=1                # honour X-Forwarded-* from the TLS-terminating reverse proxy
# COOKIE_SECURE=1              # Secure session cookie; set whenever served over HTTPS
# CORS_ORIGIN=https://finsentinel.example.com   # comma-separated allow-list; unset reflects any origin
# Demo pacing for the mock gateway (ms per simulated model call); set 0 for speed
MOCK_LATENCY_MS=1800

{
  "name": "finsentinel",
  "version": "0.1.0",
  "description": "FinSentinel — Financial Crime Risk Assessment Workbench. AI prepares. Rules calculate. Humans decide.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "dev:api": "node --env-file=.env --watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "fixtures": "node scripts/make-fixtures.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:integration": "playwright test --project=integration",
    "test:security": "playwright test --project=security",
    "test:adversarial": "playwright test --project=adversarial",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:all": "playwright test && playwright test -c playwright.e2e.config.ts",
    "test:coverage": "c8 playwright test",
    "eval": "node --env-file=.env evaluations/run.ts",
    "gate": "node --env-file=.env scripts/quality-gate.ts",
    "backup": "node --env-file=.env scripts/backup.ts",
    "criteria:report": "node scripts/criteria-report.ts",
    "manual:capture": "node scripts/manual/diagrams.ts && playwright test -c playwright.manual.config.ts",
    "manual:pdf": "node scripts/manual/pdf.ts",
    "start:prod": "node --env-file-if-exists=.env src/server.ts",
    "smoke": "node scripts/smoke.ts",
    "restore": "node --env-file=.env scripts/restore.ts",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev",
    "heartbeat": "node --env-file=.env scripts/heartbeat.ts",
    "eval:compare": "node scripts/eval-compare.ts",
    "feedback:export": "node --env-file=.env scripts/feedback-export.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.1.1",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "c8": "^12.0.0",
    "docx": "^9.5.0",
    "marked": "^18.0.14",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
